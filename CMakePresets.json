{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "sensored-debug",
            "inherits": "Debug",
            "cacheVariables": { "FOC_PROFILE": "sensored" }
        },
        {
            "name": "sensorless-debug",
            "inherits": "Debug",
            "cacheVariables": { "FOC_PROFILE": "sensorless" }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "sensored-debug",
            "configurePreset": "sensored-debug"
        },
        {
            "name": "sensorless-debug",
            "configurePreset": "sensorless-debug"
        },
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        }
    ]
}
