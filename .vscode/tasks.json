{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Build Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "CMake: Configure Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "DAPLink: Flash Debug",
            "type": "process",
            "command": "pyocd",
            "args": [
                "flash",
                "--pack",
                "${env:LOCALAPPDATA}\\Arm\\Packs\\.Download\\Keil.STM32G4xx_DFP.2.0.0.pack",
                "-O",
                "cmsis_dap.limit_packets=1",
                "-e",
                "sector",
                "-t",
                "stm32g431cbux",
                "-M",
                "under-reset",
                "-f",
                "800000",
                "--no-wait",
                "${workspaceFolder}\\build\\Debug\\g431_foc.elf"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "CMake: Build Debug"
            ],
            "problemMatcher": []
        }
    ]
}
